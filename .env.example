# ─── ContentOS environment ─────────────────────────────────────────
# Copy to .env and fill in. Anything left blank falls back to a free local driver.

NODE_ENV=development

# Database (docker compose exposes postgres on 5432)
POSTGRES_USER=contentos
POSTGRES_PASSWORD=contentos
POSTGRES_DB=contentos
DATABASE_URL=postgresql://contentos:contentos@localhost:5432/contentos

# Public URLs. /api/* is served from the same origin as the app
# (Next.js rewrites in dev, Caddy in production).
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
API_PORT=4000
# Where the web server reaches the API directly (server-side fetches + rewrites)
API_INTERNAL_URL=http://localhost:4000

# Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-random-32+-character-secret
# Google OAuth (sign-in + Calendar scope). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage: local | minio | r2
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
S3_BUCKET=contentos-assets
S3_REGION=auto
# minio: http://localhost:9000   r2: leave blank and set R2_ACCOUNT_ID
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

# AI (Ollama)
OLLAMA_HOST=http://localhost:11434
AI_MODEL=mistral:7b-instruct
AI_EMBED_MODEL=nomic-embed-text

# Email: log | smtp | zeptomail   (smtp → mailhog in dev: smtp://localhost:1025)
EMAIL_DRIVER=log
SMTP_URL=
ZEPTOMAIL_TOKEN=

# Billing (Paystack test keys)
PAYSTACK_SECRET_KEY=

# Feature flags — gated modules (see PRD.md §5)
FEATURE_PUBLISHER=false
FEATURE_ANALYTICS=false
FEATURE_IMAGE_GEN=false
FEATURE_BILLING=false

# First docker compose boot: seed the Ombra Fiore demo workspace
SEED_ON_START=false

# Caddy (production)
DOMAIN=localhost
